@model ProjetoLoja.Models.Produto

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<h1>Detalhes do Produto</h1>

<div>
    <p><strong>Nome:</strong> @Model.Nome</p>
    <p><strong>Descrição:</strong> @Model.Descricao</p>
    <p><strong>Preço:</strong> @Model.Preco</p>
    <p><strong>Estoque:</strong> @Model.Estoque</p>
    <p><strong>Categoria:</strong> @Model.Categoria</p>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Voltar para lista</a>
</p>