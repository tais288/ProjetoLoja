@model ProjetoLoja.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<h1>Excluir Produto</h1>

<h3>Tem certeza que deseja excluir este produto?</h3>

<div>
    <p><strong>Nome:</strong> @Model.Nome</p>
    <p><strong>Descrição:</strong> @Model.Descricao</p>
    <p><strong>Preço:</strong> @Model.Preco</p>
    <p><strong>Estoque:</strong> @Model.Estoque</p>
    <p><strong>Categoria:</strong> @Model.Categoria</p>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">Excluir</button>

    <a asp-action="Index">Cancelar</a>

</form>