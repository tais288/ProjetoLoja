@model ProjetoLoja.Models.Produto

@{
    ViewData["Title"] = "Excluir Produto";
}

<div class="page-heading"><div><a class="back-link" asp-controller="Home" asp-action="Index">← Voltar para início</a><div class="eyebrow">Catálogo</div><h1>Excluir produto</h1><p>Esta ação não poderá ser desfeita.</p></div></div>
<div class="delete-shell">
    <h2>Tem certeza que deseja excluir este produto?</h2>
    <p><strong>@Model.Nome</strong> será removido do catálogo.</p>
    <form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-actions"><button class="btn btn-danger" type="submit">Excluir produto</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
    </form>
</div>