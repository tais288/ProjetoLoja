@model IEnumerable<ProjetoLoja.Models.Produto>

@{
    ViewData["Title"] = "Produtos";
}

<div class="page-heading">
    <div>
        <a class="back-link" asp-controller="Home" asp-action="Index">← Voltar para início</a>
        <div class="eyebrow">Catálogo</div>
        <h1>Produtos</h1>
        <p>Acompanhe seu catálogo e mantenha o estoque sob controle.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Novo produto</a>
</div>

<div class="table-shell table-responsive">
<table class="table app-table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Categoria</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var produto in Model)
        {
            <tr>
                <td class="table-primary-text">@produto.Nome</td>
                <td class="table-muted">@produto.Descricao</td>
                <td class="table-primary-text">@produto.Preco</td>
                <td class="table-muted">@produto.Estoque</td>
                <td class="table-muted">@produto.Categoria</td>
                <td class="table-actions">
                    <a asp-action="Details" asp-route-id="@produto.Id">Ver</a>
                    <a asp-action="Edit" asp-route-id="@produto.Id">Editar</a>
                    <a class="danger-link" asp-action="Delete" asp-route-id="@produto.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>