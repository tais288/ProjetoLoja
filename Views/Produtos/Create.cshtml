@model ProjetoLoja.Models.Produto

@{
    ViewData["Title"] = "Cadastrar Produto";
}

<div class="page-heading"><div><a class="back-link" asp-controller="Home" asp-action="Index">← Voltar para início</a><div class="eyebrow">Catálogo</div><h1>Cadastrar produto</h1><p>Inclua um novo item no catálogo da loja.</p></div></div>
<div class="form-shell"><form asp-action="Create" method="post"><div class="form-grid">
    <div class="form-group"><label class="form-label" asp-for="Nome"></label><input class="form-control" asp-for="Nome" /><span class="validation-error" asp-validation-for="Nome"></span>
    </div>
    <div class="form-group"><label class="form-label" asp-for="Descricao"></label><input class="form-control" asp-for="Descricao" />
    </div>
    <div class="form-group"><label class="form-label" asp-for="Preco"></label><input class="form-control" asp-for="Preco" /><span class="validation-error" asp-validation-for="Preco"></span>
    </div>
    <div class="form-group"><label class="form-label" asp-for="Estoque"></label><input class="form-control" asp-for="Estoque" />
    </div>
    <div class="form-group"><label class="form-label" asp-for="Categoria"></label><input class="form-control" asp-for="Categoria" />
    </div>
    </div><div class="form-actions"><button class="btn btn-primary" type="submit">Cadastrar produto</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}