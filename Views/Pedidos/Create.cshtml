@model ProjetoLoja.Models.Pedido

@{
    ViewData["Title"] = "Cadastrar Pedido";
}

<h1>Cadastrar Pedido</h1>

<form asp-action="Create" method="post">

    <div>
        <label asp-for="ClienteId"></label>
        <input asp-for="ClienteId" />
        <span asp-validation-for="ClienteId"></span>
    </div>

    <div>
        <label asp-for="Data"></label>
        <input asp-for="Data" type="datetime-local" />
    </div>

    <div>
        <label asp-for="ValorTotal"></label>
        <input asp-for="ValorTotal" />
    </div>

    <div>
        <label asp-for="Status"></label>
        <input asp-for="Status" />
    </div>

    <div>
        <label asp-for="Observacao"></label>
        <input asp-for="Observacao" />
    </div>

    <br />

    <button type="submit">Cadastrar</button>

</form>

<p>
    <a asp-action="Index">Voltar para lista</a>
</p>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}