@model IEnumerable<ProjetoLoja.Models.Pedido>

@{
    ViewData["Title"] = "Pedidos";
}

<h1>Pedidos</h1>

<p>
    <a asp-action="Create">Cadastrar novo pedido</a>
</p>

<table>
    <thead>
        <tr>
            <th>Cliente ID</th>
            <th>Data</th>
            <th>Valor Total</th>
            <th>Status</th>
            <th>Observação</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var pedido in Model)
        {
            <tr>
                <td>@pedido.ClienteId</td>
                <td>@pedido.Data</td>
                <td>@pedido.ValorTotal</td>
                <td>@pedido.Status</td>
                <td>@pedido.Observacao</td>
                <td>
                    <a asp-action="Details" asp-route-id="@pedido.Id">Detalhes</a> |
                    <a asp-action="Edit" asp-route-id="@pedido.Id">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@pedido.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>