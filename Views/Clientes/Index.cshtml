@model IEnumerable<ProjetoLoja.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="page-heading">
    <div>
        <a class="back-link" asp-controller="Home" asp-action="Index">← Voltar para início</a>
        <div class="eyebrow">Relacionamento</div>
        <h1>Clientes</h1>
        <p>Gerencie os contatos que fazem parte da sua operação.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Novo cliente</a>
</div>

<div class="table-shell table-responsive">
<table class="table app-table">
    <thead>
        <tr>
            <th>Nome</th>
            <th>CPF</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Cidade</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td class="table-primary-text">@cliente.Nome</td>
                <td class="table-muted">@cliente.CPF</td>
                <td class="table-muted">@cliente.Email</td>
                <td class="table-muted">@cliente.Telefone</td>
                <td class="table-muted">@cliente.Cidade</td>
                <td class="table-actions">
                    <a asp-action="Details" asp-route-id="@cliente.Id">Ver</a>
                    <a asp-action="Edit" asp-route-id="@cliente.Id">Editar</a>
                    <a class="danger-link" asp-action="Delete" asp-route-id="@cliente.Id">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>