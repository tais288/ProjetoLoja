@model ProjetoLoja.Models.Cliente

@{
    ViewData["Title"] = "Cadastrar Cliente";
}

<div class="page-heading">
    <div><a class="back-link" asp-controller="Home" asp-action="Index">← Voltar para início</a><div class="eyebrow">Relacionamento</div><h1>Cadastrar cliente</h1><p>Adicione uma nova pessoa à sua base de clientes.</p></div>
</div>

<div class="form-shell">
<form asp-action="Create" method="post">
    <div class="form-grid">
    <div class="form-group">
        <label class="form-label" asp-for="Nome"></label>
        <input class="form-control" asp-for="Nome" />
        <span class="validation-error" asp-validation-for="Nome"></span>
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="CPF"></label>
        <input class="form-control" asp-for="CPF" />
        <span class="validation-error" asp-validation-for="CPF"></span>
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="Email"></label>
        <input class="form-control" asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="Telefone"></label>
        <input class="form-control" asp-for="Telefone" />
    </div>
    <div class="form-group">
        <label class="form-label" asp-for="Cidade"></label>
        <input class="form-control" asp-for="Cidade" />
    </div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Cadastrar cliente</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
</form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}