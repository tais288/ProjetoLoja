@model ProjetoLoja.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<h1>Editar Cliente</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div>
        <label asp-for="Nome"></label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome"></span>
    </div>

    <div>
        <label asp-for="CPF"></label>
        <input asp-for="CPF" />
        <span asp-validation-for="CPF"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Telefone"></label>
        <input asp-for="Telefone" />
    </div>

    <div>
        <label asp-for="Cidade"></label>
        <input asp-for="Cidade" />
    </div>

    <br />

    <button type="submit">Salvar alterações</button>

</form>

<p>
    <a asp-action="Index">Voltar para lista</a>
</p>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}