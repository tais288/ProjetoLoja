@model ProjetoLoja.Models.Cliente

@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="page-heading"><div><a class="back-link" asp-controller="Home" asp-action="Index">← Voltar para início</a><div class="eyebrow">Relacionamento</div><h1>Excluir cliente</h1><p>Esta ação não poderá ser desfeita.</p></div></div>
<div class="delete-shell">
    <h2>Tem certeza que deseja excluir este cliente?</h2>
    <p><strong>@Model.Nome</strong> será removido da base de clientes.</p>
    <form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-actions"><button class="btn btn-danger" type="submit">Excluir cliente</button><a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a></div>
    </form>
</div>