@model ProjetoLoja.Models.Cliente

@{
    ViewData["Title"] = "Excluir Cliente";
}

<h1>Excluir Cliente</h1>

<h3>Tem certeza que deseja excluir este cliente?</h3>

<div>
    <p><strong>Nome:</strong> @Model.Nome</p>
    <p><strong>CPF:</strong> @Model.CPF</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Telefone:</strong> @Model.Telefone</p>
    <p><strong>Cidade:</strong> @Model.Cidade</p>
</div>

<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit">Excluir</button>

    <a asp-action="Index">Cancelar</a>

</form>