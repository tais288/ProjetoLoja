@model ProjetoLoja.Models.Cliente

@{
    ViewData["Title"] = "Detalhes do Cliente";
}

<div class="page-heading"><div><a class="back-link" asp-controller="Home" asp-action="Index">← Voltar para início</a><div class="eyebrow">Relacionamento</div><h1>Detalhes do cliente</h1><p>Confira as informações deste cadastro.</p></div></div>
<div class="detail-shell">
    <dl class="detail-list">
        <div class="detail-item"><dt>Nome</dt><dd>@Model.Nome</dd></div>
        <div class="detail-item"><dt>CPF</dt><dd>@Model.CPF</dd></div>
        <div class="detail-item"><dt>Email</dt><dd>@Model.Email</dd></div>
        <div class="detail-item"><dt>Telefone</dt><dd>@Model.Telefone</dd></div>
        <div class="detail-item"><dt>Cidade</dt><dd>@Model.Cidade</dd></div>
    </dl>
    <div class="form-actions"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar cliente</a><a class="btn btn-outline-secondary" asp-action="Index">Voltar</a></div>
</div>